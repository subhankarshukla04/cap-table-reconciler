{% extends "base.html.j2" %}
{% block title %}History — Tender Radar{% endblock %}
{% block content %}
<section class="title-block">
  <h1>Digest history</h1>
  <p class="dateline">Past daily runs · click a date to open the archived digest</p>
</section>
<section>
  <table class="rank">
    <thead>
      <tr>
        <th>Date</th>
        <th>Top 3</th>
        <th class="num">Alerts fired</th>
        <th>Archive</th>
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
      <tr>
        <td class="mono">{{ row.date }}</td>
        <td>{{ row.top3 | join(" · ") }}</td>
        <td class="num">{{ row.alert_count }}</td>
        <td><a href="/static-digest/{{ row.filename }}">{{ row.filename }}</a></td>
      </tr>
      {% else %}
      <tr><td colspan="4" class="muted">No archived digests yet. Run <code>make demo-day</code>.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</section>
{% endblock %}
